# ============================================================
# .env.example - Sao chép file này thành .env và điền giá trị
# KHÔNG BAO GIỜ commit file .env lên git!
# ============================================================

# --- Ứng dụng ---
APP_NAME="WebGIS Ngập Đô Thị"
APP_VERSION="1.0.0"
DEBUG=False

# --- PostgreSQL + PostGIS ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=webgis_ngap
DB_USER=postgres
DB_PASSWORD=your_password_here

# --- JWT Authentication ---
SECRET_KEY=your-very-long-random-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (phân cách bằng dấu phẩy) ---
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:5500"]

# --- Đường dẫn dữ liệu GIS ---
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DEM_FILE=data/raw/dem.tif

# --- Kịch bản ngập ---
FLOOD_THRESHOLDS=[100,200,300]

